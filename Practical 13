#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
#include <stdlib.h>

int main() {
    int n, i;
    pid_t pid;

    printf("Enter number of child processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        pid = fork();

        if (pid < 0) {
            printf("Fork failed\n");
            exit(1);
        }
        else if (pid == 0) {
            printf("Child Process %d | PID = %d | Parent PID = %d\n",
                   i + 1, getpid(), getppid());
            exit(0);
        }
    }

    for (i = 0; i < n; i++) {
        wait(NULL);
    }

    printf("Parent process completed\n");

    return 0;
}
