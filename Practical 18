#include <stdio.h>
#include <stdlib.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/types.h>
#include <unistd.h>

int main() {
    key_t key = ftok("shmfile", 65);

    int shmid = shmget(key, 1024, 0666 | IPC_CREAT);

    if (shmid == -1) {
        printf("Shared memory creation failed\n");
        return 1;
    }

    char *str = (char *) shmat(shmid, NULL, 0);

    if (str == (char *) -1) {
        printf("Shared memory attach failed\n");
        return 1;
    }

    if (fork() == 0) {
        sprintf(str, "Hello from Child Process (PID: %d)", getpid());
        printf("Child wrote to shared memory\n");
    } else {
        sleep(1);
        printf("Parent reads: %s\n", str);
        wait(NULL);

        shmdt(str);
        shmctl(shmid, IPC_RMID, NULL);
    }

    return 0;
}
