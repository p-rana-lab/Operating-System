echo "Enter number of prime numbers to display:"
read n

count=0
num=2

is_prime() {
    i=2
    while [ $i -le `expr $1 / 2` ]
    do
        if [ `expr $1 % $i` -eq 0 ]
        then
            return 1
        fi
        i=`expr $i + 1`
    done
    return 0
}

while [ $count -lt $n ]
do
    is_prime $num
    if [ $? -eq 0 ]
    then
        echo $num
        count=`expr $count + 1`
    fi
    num=`expr $num + 1`
done
